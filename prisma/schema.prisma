datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Item {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String
  preco       Float
  tipo        String   // "PRODUTO" ou "SERVICO"
  imagemUrl   String?
  criadoEm    DateTime @default(now())
}